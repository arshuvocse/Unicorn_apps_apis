<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/login_masterLayoutId"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_gradient"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none"
    tools:context=".Activity.MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="700dp"
        android:paddingStart="22dp"
        android:paddingEnd="22dp">

        <View
            android:id="@+id/glowTop"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_marginTop="-70dp"
            android:alpha="0.12"
            android:background="@drawable/shape_circle_white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Floating Background Capsule Vector Icons -->
        <ImageView
            android:id="@+id/bgCapsule1"
            android:layout_width="95dp"
            android:layout_height="95dp"
            android:layout_marginStart="-25dp"
            android:layout_marginTop="25dp"
            android:alpha="0.12"
            android:rotation="-30"
            android:src="@drawable/ic_capsule_vector"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/bgCapsule2"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginTop="140dp"
            android:layout_marginEnd="8dp"
            android:alpha="0.10"
            android:rotation="40"
            android:src="@drawable/ic_capsule_vector"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/bgCapsule3"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_marginStart="-30dp"
            android:layout_marginBottom="80dp"
            android:alpha="0.08"
            android:rotation="15"
            android:src="@drawable/ic_capsule_vector"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/bgCapsule4"
            android:layout_width="85dp"
            android:layout_height="85dp"
            android:layout_marginEnd="-20dp"
            android:layout_marginBottom="15dp"
            android:alpha="0.12"
            android:rotation="-55"
            android:src="@drawable/ic_capsule_vector"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/loginLogo"
            android:layout_width="210dp"
            android:layout_height="92dp"
            android:layout_marginTop="34dp"
            android:background="@drawable/bg_logo_glass"
            android:contentDescription="@string/app_name"
            android:elevation="8dp"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/unicorn_logo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/lato_bold"
            android:text="Welcome Back"
            android:textColor="@color/white"
            android:textSize="27sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/loginLogo" />

        <TextView
            android:id="@+id/textView5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.9"
            android:fontFamily="@font/latoregular"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textView"
            tools:text="Unicorn" />

        <FrameLayout
            android:id="@+id/cardContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textView5">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/loginCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:elevation="18dp"
                app:cardBackgroundColor="#F2FFFFFF"
                app:cardCornerRadius="28dp"
                app:cardElevation="18dp"
                app:strokeColor="#55FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:id="@+id/inputl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="22dp"
                    android:paddingTop="24dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="22dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/lato_bold"
                        android:text="Sign in to continue"
                        android:textColor="#1B2B4B"
                        android:textSize="19sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:layout_marginBottom="18dp"
                        android:fontFamily="@font/latoregular"
                        android:text="Enter your account credentials"
                        android:textColor="#6F7890"
                        android:textSize="13sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputEmail"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/login_id"
                        app:boxBackgroundColor="#FAFCFF"
                        app:boxCornerRadiusBottomEnd="15dp"
                        app:boxCornerRadiusBottomStart="15dp"
                        app:boxCornerRadiusTopEnd="15dp"
                        app:boxCornerRadiusTopStart="15dp"
                        app:boxStrokeColor="@color/main"
                        app:hintTextColor="#60708F"
                        app:startIconDrawable="@drawable/ic_login_user">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputLoginName"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:fontFamily="@font/latoregular"
                            android:imeOptions="actionNext"
                            android:inputType="text"
                            android:maxLines="1"
                            android:textColor="#17233F"
                            android:textColorHint="#7B8498" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/passwordTL"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/password"
                        app:boxBackgroundColor="#FAFCFF"
                        app:boxCornerRadiusBottomEnd="15dp"
                        app:boxCornerRadiusBottomStart="15dp"
                        app:boxCornerRadiusTopEnd="15dp"
                        app:boxCornerRadiusTopStart="15dp"
                        app:boxStrokeColor="@color/main"
                        app:endIconMode="password_toggle"
                        app:hintTextColor="#60708F"
                        app:startIconDrawable="@drawable/ic_login_lock">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputPassword"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:fontFamily="@font/latoregular"
                            android:imeOptions="actionDone"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:textColor="#17233F"
                            android:textColorHint="#7B8498" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/forgotPassword"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_gravity="end"
                        android:fontFamily="@font/lato"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="4dp"
                        android:text="@string/forgot_pass_txt"
                        android:textColor="@color/main"
                        android:textSize="13sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnLogin"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_login_button_glossy"
                        android:backgroundTint="@null"
                        android:elevation="7dp"
                        android:fontFamily="@font/lato_bold"
                        android:letterSpacing="0.04"
                        android:text="@string/login_txt"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="17sp" />

                    <LinearLayout
                        android:id="@+id/llversion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/app_version"
                            android:textColor="#7A8498"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/vname"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:textColor="#7A8498"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/locationCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:elevation="18dp"
                android:visibility="gone"
                app:cardBackgroundColor="#F2FFFFFF"
                app:cardCornerRadius="28dp"
                app:cardElevation="18dp"
                app:strokeColor="#55FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingStart="22dp"
                    android:paddingTop="24dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="22dp">

                    <ImageView
                        android:id="@+id/locationIcon"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginBottom="16dp"
                        android:src="@drawable/ic_location_tracking"
                        app:tint="@color/main" />

                    <TextView
                        android:id="@+id/locationTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/lato_bold"
                        android:textColor="#1B2B4B"
                        android:textSize="19sp"
                        android:gravity="center"
                        android:layout_marginBottom="8dp"
                        tools:text="Location Access Required" />

                    <TextView
                        android:id="@+id/locationDescription"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/latoregular"
                        android:textColor="#6F7890"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:layout_marginBottom="24dp"
                        tools:text="This application requires location access to function. Please enable it to continue." />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnEnableLocation"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_login_button_glossy"
                        android:backgroundTint="@null"
                        android:elevation="7dp"
                        android:fontFamily="@font/lato_bold"
                        android:letterSpacing="0.04"
                        android:text="Enable Location"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="17sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </FrameLayout>

        <LinearLayout
            android:id="@+id/footer"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardContainer"
            app:layout_constraintVertical_bias="1">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_copyright"
                app:tint="#CCFFFFFF" />

            <TextView
                android:id="@+id/year"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:textColor="#E6FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/site"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/latoregular"
                android:text="@string/creatrix_soft_tech_ltd"
                android:textColor="#E6FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
