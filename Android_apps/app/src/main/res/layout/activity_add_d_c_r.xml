        <include
            android:id="@+id/dochead"
            layout="@layout/layout_doctor_global" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_dcr_card_glossy"
            android:elevation="5dp"
            android:orientation="horizontal"
            android:padding="16dp"
            android:weightSum="3">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/lato_bold"
                android:text="@string/tag_date"
                android:textColor="@color/deepBlue"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/dcrdate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:fontFamily="@font/latoregular"
                android:gravity="end"
                android:textColor="#24344F"
                android:textSize="14sp" />
            <!--<ImageView
                android:id="@+id/datePickerdcrDate"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_calendar"


                />-->

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_dcr_card_glossy"
            android:elevation="5dp"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lato_bold"
                android:text="@string/visit_type"
                android:textColor="@color/deepBlue"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/spiner_visitType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_dcr_field"
                android:contentDescription="@string/_0"
                android:minHeight="48dp" />


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_dcr_card_glossy"
            android:elevation="5dp"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lato_bold"
                android:text="@string/chamber"
                android:textColor="@color/deepBlue"
                android:textSize="14sp" />

            <RadioGroup
                android:id="@+id/rg_shift"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_morning"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/lato_bold"
                    android:text="@string/morning"
                    android:textColor="@color/black"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rb_evening"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/lato_bold"
                    android:text="@string/evening"
                    android:textColor="@color/black"
                    android:textSize="14sp" />

            </RadioGroup>

            <Spinner
                android:id="@+id/chamberSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_dcr_field"
                android:contentDescription="@string/tag_spinner"
                android:minHeight="48dp" />

            <LinearLayout
                android:id="@+id/chamberInfoSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/chamberSittingTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/latoregular"
                    android:textColor="@color/deepBlue"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:text="Time: 10:00 AM - 01:00 PM" />

                <TextView
                    android:id="@+id/chamberAddressTxt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/latoregular"
                    android:textColor="@color/deepBlue"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:text="Address: House 12, Road 5, Dhaka" />

                <ImageButton
                    android:id="@+id/chamberLocationBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/chamber_location_save"
                    android:padding="6dp"
                    android:src="@drawable/ic_location"
                    android:tint="@color/deepBlue"
                    android:visibility="gone" />

            </LinearLayout>


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_dcr_card_glossy"
            android:elevation="5dp"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tag_territory"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/territorySpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                />


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_dcr_card_glossy"
            android:elevation="5dp"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tag_market"
                android:fontFamily="@font/lato" />

            <Spinner
                android:id="@+id/marketSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                />


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_dcr_card_glossy"
            android:elevation="5dp"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tag_sub_market"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/submarketSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                />


        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_dcr_card_glossy"
            android:elevation="5dp"
            android:orientation="vertical"
            android:padding="14dp"

            >

            <TextView
                android:id="@+id/visitSec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:fontFamily="@font/lato_bold"
                android:text="@string/visited_with"
                android:textColor="@color/deepBlue"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/visitedWithAdd"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_dcr_add_button"
                android:padding="8dp"
                android:src="@drawable/ic_baseline_add_24"
                android:contentDescription="@string/image" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view_VisitedWith"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/visitSec"
                android:layout_marginStart="10dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:clipToPadding="false"
                android:paddingBottom="10dp"
                android:scrollbars="vertical" />

        </RelativeLayout>


        <RelativeLayout
            android:id="@+id/promoGiftSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_dcr_card_glossy"
            android:elevation="5dp"
            android:orientation="vertical"
            android:padding="14dp"

            >

            <TextView
                android:id="@+id/brandLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:fontFamily="@font/lato_bold"
                android:text="@string/tag_brand"
                android:textColor="@color/deepBlue"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/brandAdd"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_dcr_add_button"
                android:padding="8dp"
                android:src="@drawable/ic_baseline_add_24"
                android:contentDescription="@string/image">

            </ImageView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_viewBrand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/brandAdd"
                android:layout_alignParentStart="true"
                android:layout_alignParentEnd="true"
                android:clipToPadding="false"
                android:paddingBottom="10dp"
                android:scrollbars="vertical" />

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_dcr_card_glossy"
            android:elevation="5dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone"

            >

            <TextView
                android:id="@+id/giftLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:fontFamily="@font/lato_bold"
                android:text="@string/tag_promo_gift"
                android:textColor="@color/deepBlue"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/giftAdd"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_dcr_add_button"
                android:padding="8dp"
                android:src="@drawable/ic_baseline_add_24"
                android:contentDescription="@string/image">

            </ImageView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_viewGift"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/giftAdd"
                android:layout_alignParentStart="true"
                android:layout_alignParentEnd="true"
                android:clipToPadding="false"
                android:paddingBottom="10dp"
                android:scrollbars="vertical" />

        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_dcr_card_glossy"
            android:elevation="5dp"
            android:orientation="vertical"
            android:padding="14dp"


            >

            <EditText
                android:id="@+id/comment"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:background="@drawable/bg_dcr_field"
                android:fontFamily="@font/latoregular"
                android:gravity="top|start"
                android:hint="Comment *"
                android:inputType="textCapSentences|textMultiLine"
                android:padding="12dp"
                android:textColor="#24344F"
                android:textColorHint="#7A8AA3"
                android:textSize="14sp" />

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_dcr_card_glossy"
            android:elevation="5dp"
            android:orientation="horizontal"
            android:padding="14dp">

            <TextView
                android:id="@+id/latlon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center"
                android:fontFamily="@font/latoregular"
                android:hint="Location"
                android:textSize="14sp"
                android:textColor="@color/deepBlue"
                android:textColorHint="#7A8AA3" />
            <ImageView
                android:id="@+id/location"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_dcr_add_button"
                android:contentDescription="@string/image"
                android:padding="9dp"
                android:src="@drawable/ic_location_wide"
                app:tint="@color/white"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="12dp"
            android:background="@android:color/transparent"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <Button
                android:id="@+id/submitbtnClick"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_dcr_submit_button"
                android:backgroundTint="@null"
                android:elevation="6dp"
                android:padding="12dp"
                android:text="@string/tag_submit"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:fontFamily="@font/lato_bold"
                android:textColor="@color/white" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>