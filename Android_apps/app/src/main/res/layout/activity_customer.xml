<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_doctor_form_screen"
    android:orientation="vertical"
    tools:context=".Activity.Customer.CustomerActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_custom"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/bg_doctor_form_toolbar"
        android:elevation="12dp"
        android:paddingEnd="8dp"
        app:navigationIcon="@drawable/ic_arrow_back_white_24"
        app:theme="@style/ToolbarThemeMainColor">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lato_bold"
                android:text="@string/add_customer"
                android:textColor="@color/white"
                android:textSize="21sp" />
        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:id="@+id/masterLayoutId"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="14dp"
            android:paddingEnd="12dp"
            android:paddingBottom="20dp">

            <RelativeLayout
                android:id="@+id/providerInfoSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_doctor_form_section"
                android:elevation="7dp"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/providerInfoTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lato_bold"
                    android:text="Select Provider Info"
                    android:textColor="@color/deepBlue"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/changeptype"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/providerInfoTitle"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_doctor_form_button"
                    android:fontFamily="@font/lato_bold"
                    android:paddingHorizontal="22dp"
                    android:paddingVertical="10dp"
                    android:text="Select"
                    android:textColor="@color/white" />
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_doctor_form_section"
                android:elevation="7dp"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:fontFamily="@font/lato_bold"
                    android:text="Customer Information"
                    android:textColor="@color/deepBlue"
                    android:textSize="16sp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:hint="@string/doctor_mobile">

                    <EditText
                        android:id="@+id/customerMobile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_doctor_form_field"
                        android:digits="0123456789"
                        android:inputType="phone"
                        android:maxLength="11"
                        android:minHeight="54dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textSize="16sp"
                        tools:ignore="LabelFor,SpeakableTextPresentCheck" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:hint="@string/chemist_name">

                    <EditText
                        android:id="@+id/customerName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_doctor_form_field"
                        android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz1234567890 .-"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:minHeight="54dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textSize="16sp"
                        tools:ignore="LabelFor,SpeakableTextPresentCheck" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:hint="@string/customer_address">

                    <EditText
                        android:id="@+id/address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_doctor_form_field"
                        android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789 .,-/"
                        android:inputType="textPostalAddress"
                        android:minHeight="54dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textSize="16sp"
                        tools:ignore="LabelFor,SpeakableTextPresentCheck" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_doctor_form_section"
                android:elevation="7dp"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:fontFamily="@font/lato_bold"
                    android:text="Business Information"
                    android:textColor="@color/deepBlue"
                    android:textSize="16sp" />

                <RelativeLayout
                    android:id="@+id/providerTypeSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_doctor_form_field"
                    android:elevation="3dp"
                    android:padding="12dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/providerTypeLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/latoregular"
                        android:text="Provider Type"
                        android:textColor="@color/black"
                        android:textSize="14sp" />

                    <Spinner
                        android:id="@+id/ptypeSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_below="@id/providerTypeLabel"
                        android:entries="@array/demodata" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/pharmaPlatformSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_doctor_form_field"
                    android:elevation="3dp"
                    android:padding="12dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/smctypeLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/latoregular"
                            android:text="@string/smc_type"
                            android:textColor="@color/black"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/changesmctype"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_doctor_form_button"
                            android:fontFamily="@font/lato_bold"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="5dp"
                            android:text="@string/change"
                            android:textColor="@color/white"
                            android:visibility="gone" />
                    </LinearLayout>

                    <Spinner
                        android:id="@+id/smcTypeSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_below="@id/smctypeLabel"
                        android:entries="@array/demodata" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/custTypeSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_doctor_form_field"
                    android:elevation="3dp"
                    android:padding="12dp"
                    android:visibility="visible">

                    <TextView
                        android:id="@+id/custTypeLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/latoregular"
                        android:text="@string/customer_type_label"
                        android:textColor="@color/black"
                        android:textSize="14sp" />

                    <Spinner
                        android:id="@+id/custTypeSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_below="@id/custTypeLabel" />
                </RelativeLayout>

                <Spinner
                    android:id="@+id/custStationSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:hint="@string/owner_name">

                    <EditText
                        android:id="@+id/cmist_ownerName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_doctor_form_field"
                        android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz1234567890 .,-"
                        android:inputType="text"
                        android:minHeight="54dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textSize="16sp"
                        tools:ignore="LabelFor,SpeakableTextPresentCheck" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/nidInputLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:hint="@string/nid_number"
                    android:visibility="visible">

                    <EditText
                        android:id="@+id/cmist_nid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_doctor_form_field"
                        android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz1234567890 .,-"
                        android:inputType="text"
                        android:maxLength="17"
                        android:minHeight="54dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="@color/black"
                        android:textColorHint="@color/black"
                        android:textSize="16sp"
                        tools:ignore="LabelFor,SpeakableTextPresentCheck" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:hint="Referred Doctor (if any)">

                    <EditText
                        android:id="@+id/cmist_tradeLicense"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_doctor_form_field"
                        android:inputType="text"
                        android:minHeight="54dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textSize="16sp"
                        tools:ignore="LabelFor,SpeakableTextPresentCheck" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/marketStructureSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_doctor_form_section"
                android:elevation="7dp"
                android:orientation="vertical"
                android:padding="8dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:fontFamily="@font/lato_bold"
                    android:text="Location Information"
                    android:textColor="@color/deepBlue"
                    android:textSize="16sp" />

                <RelativeLayout
                    android:id="@+id/regiondiv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_doctor_form_field"
                    android:elevation="3dp"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/regionLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/latoregular"
                        android:text="@string/tag_zone"
                        android:textColor="@color/black"
                        android:textSize="14sp" />

                    <Spinner
                        android:id="@+id/regionSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_below="@id/regionLabel"
                        tools:ignore="SpeakableTextPresentCheck" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/areadiv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_doctor_form_field"
                    android:elevation="3dp"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/areaLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/latoregular"
                        android:text="@string/tag_area"
                        android:textColor="@color/black"
                        android:textSize="14sp" />

                    <Spinner
                        android:id="@+id/areaSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_below="@id/areaLabel"
                        tools:ignore="SpeakableTextPresentCheck" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/teridiv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_doctor_form_field"
                    android:elevation="3dp"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/territoryLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/latoregular"
                        android:text="@string/tag_territory"
                        android:textColor="@color/black"
                        android:textSize="14sp" />

                    <Spinner
                        android:id="@+id/territorySpinner"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_below="@id/territoryLabel" />
                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/subterritorydiv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_doctor_form_field"
                    android:elevation="3dp"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:id="@+id/subteriLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/latoregular"
                            android:text="@string/subterritory"
                            android:textColor="@color/black"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <Spinner
                        android:id="@+id/sterritorySpinner"
                        android:layout_width="match_parent"
                        android:layout_height="40dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/marketdiv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_doctor_form_field"
                    android:elevation="3dp"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:id="@+id/marketLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/latoregular"
                            android:text="@string/market"
                            android:textColor="@color/black"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <Spinner
                        android:id="@+id/marketSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="40dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_doctor_form_section"
                android:elevation="7dp"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:fontFamily="@font/lato_bold"
                    android:text="Customer Documents"
                    android:textColor="@color/deepBlue"
                    android:textSize="16sp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_doctor_form_field"
                    android:elevation="3dp"
                    android:padding="12dp">

                    <LinearLayout
                        android:id="@+id/llkk"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/imgName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/lato_bold"
                            android:text="@string/shop_image"
                            android:textColor="@color/deepBlue"
                            android:textSize="14sp" />

                        <ImageButton
                            android:id="@+id/camera"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_doctor_form_button"
                            android:contentDescription="@string/image"
                            android:padding="10dp"
                            android:src="@drawable/ic_baseline_add_a_photo_24"
                            app:tint="@color/white" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="170dp"
                        android:layout_below="@id/llkk"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_doctor_form_field"
                        android:padding="4dp">

                        <ImageView
                            android:id="@+id/imgbg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_imgbg" />

                        <ozaydin.serkan.com.image_zoom_view.ImageViewZoom
                            android:id="@+id/imgaeView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                    </FrameLayout>
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_doctor_form_field"
                    android:elevation="3dp"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/timgName"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:fontFamily="@font/lato_bold"
                        android:gravity="center_vertical"
                        android:text="@string/trade_image"
                        android:textColor="@color/deepBlue"
                        android:textSize="14sp" />

                    <ImageButton
                        android:id="@+id/tcamera"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_doctor_form_button"
                        android:contentDescription="@string/image"
                        android:padding="10dp"
                        android:src="@drawable/ic_baseline_add_a_photo_24"
                        app:tint="@color/white" />

                    <ImageButton
                        android:id="@+id/tgalleryButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_toStartOf="@id/tcamera"
                        android:contentDescription="@string/image"
                        android:src="@drawable/ic_baseline_add_photo_alternate_24"
                        android:visibility="gone" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="170dp"
                        android:layout_below="@id/timgName"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_doctor_form_field"
                        android:padding="4dp">

                        <ozaydin.serkan.com.image_zoom_view.ImageViewZoom
                            android:id="@+id/timgaeView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_imgbg" />
                    </FrameLayout>
                </RelativeLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnSubmit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_doctor_form_button"
                android:elevation="5dp"
                android:fontFamily="@font/lato_bold"
                android:minHeight="54dp"
                android:text="@string/tag_submit"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnUpdate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_doctor_form_button"
                android:elevation="5dp"
                android:fontFamily="@font/lato_bold"
                android:minHeight="54dp"
                android:text="@string/update"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
