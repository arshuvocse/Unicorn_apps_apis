<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_doctor_form_field"
    android:elevation="2dp"
    android:padding="8dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:layout_marginStart="2dp"
    android:layout_marginEnd="2dp">

    <TextView
        android:id="@+id/tv_shift"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/cell_shape"
        android:backgroundTint="@color/main"
        android:paddingStart="8dp"
        android:paddingTop="2dp"
        android:paddingEnd="8dp"
        android:paddingBottom="2dp"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:fontFamily="@font/lato_bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_chamberTypeName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/black"
        android:textSize="13sp"
        android:fontFamily="@font/latoregular"
        app:layout_constraintBottom_toBottomOf="@+id/tv_shift"
        app:layout_constraintStart_toEndOf="@+id/tv_shift"
        app:layout_constraintTop_toTopOf="@+id/tv_shift" />

    <TextView
        android:id="@+id/tv_chamberName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/black"
        android:textSize="15sp"
        android:fontFamily="@font/lato_bold"
        app:layout_constraintEnd_toStartOf="@+id/iv_del"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_shift" />

    <TextView
        android:id="@+id/tv_sittingTime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/darker_gray"
        android:textSize="13sp"
        android:fontFamily="@font/latoregular"
        app:layout_constraintEnd_toStartOf="@+id/iv_del"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_chamberName" />

    <TextView
        android:id="@+id/tv_chamberAddress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/darker_gray"
        android:textSize="13sp"
        android:fontFamily="@font/latoregular"
        app:layout_constraintEnd_toStartOf="@+id/iv_del"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_sittingTime" />

    <ImageView
        android:id="@+id/iv_del"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_del"
        android:padding="4dp"
        android:clickable="true"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/red"
        android:contentDescription="@string/image"
        android:focusable="true" />
</androidx.constraintlayout.widget.ConstraintLayout>