<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/masterLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_more_surface"
    tools:context=".Activity.Fragment.MoreFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_more_header_glossy"
                android:gravity="center_vertical"
                android:minHeight="174dp"
                android:orientation="horizontal"
                android:paddingStart="22dp"
                android:paddingTop="28dp"
                android:paddingEnd="22dp"
                android:paddingBottom="28dp">

                <FrameLayout
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:background="@drawable/bg_more_avatar_ring"
                    android:padding="5dp">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/profile_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/profile"
                        android:scaleType="centerCrop"
                        android:src="@mipmap/ic_userpic"
                        app:civ_border_color="@color/white"
                        app:civ_border_width="2dp" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto"
                        android:letterSpacing="0.08"
                        android:text="@string/my_profile"
                        android:textAllCaps="true"
                        android:textColor="#BFFFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/userName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/roboto"
                        android:maxLines="2"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        tools:text="John Doe" />

                    <TextView
                        android:id="@+id/userCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/roboto"
                        android:textColor="#D9FFFFFF"
                        android:textSize="14sp"
                        tools:text="EMP-1001" />

                    <TextView
                        android:id="@+id/btnLogout"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_more_logout_button"
                        android:clickable="true"
                        android:drawableStart="@drawable/ic_logout_white"
                        android:drawablePadding="8dp"
                        android:focusable="true"
                        android:gravity="center"
                        android:minWidth="108dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/log_out"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:drawableTint="@color/white" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="20dp"
                android:paddingEnd="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto"
                    android:text="@string/sync_center"
                    android:textColor="@color/more_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="@font/roboto"
                    android:text="@string/sync_center_subtitle"
                    android:textColor="@color/more_text_secondary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/btnAllSync"
                    style="@style/MoreMenuCard"
                    android:background="@drawable/bg_more_primary_card"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <FrameLayout
                        style="@style/MoreMenuIconContainer"
                        android:background="@drawable/bg_more_icon_primary">

                        <ImageView
                            style="@style/MoreMenuIcon"
                            android:contentDescription="@string/sync_all"
                            android:src="@drawable/ic_sync_grey"
                            app:tint="@color/white" />
                    </FrameLayout>

                    <LinearLayout
                        style="@style/MoreMenuTextContainer">

                        <TextView
                            style="@style/MoreMenuTitle"
                            android:text="@string/sync_all"
                            android:textColor="@color/main" />

                        <TextView
                            style="@style/MoreMenuSubtitle"
                            android:text="@string/sync_all_subtitle" />
                    </LinearLayout>

                    <ImageView
                        style="@style/MoreMenuArrow"
                        android:contentDescription="@null" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnCustomerSync"
                    style="@style/MoreMenuCard">

                    <FrameLayout style="@style/MoreMenuIconContainer">

                        <ImageView
                            style="@style/MoreMenuIcon"
                            android:contentDescription="@string/sync_customer"
                            android:src="@drawable/ic_customer"
                            app:tint="@color/main" />
                    </FrameLayout>

                    <LinearLayout style="@style/MoreMenuTextContainer">

                        <TextView
                            style="@style/MoreMenuTitle"
                            android:text="@string/sync_customer" />

                        <TextView
                            style="@style/MoreMenuSubtitle"
                            android:text="@string/sync_customer_subtitle" />
                    </LinearLayout>

                    <ImageView
                        style="@style/MoreMenuArrow"
                        android:contentDescription="@null" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnProductSyncs"
                    style="@style/MoreMenuCard">

                    <FrameLayout style="@style/MoreMenuIconContainer">

                        <ImageView
                            style="@style/MoreMenuIcon"
                            android:contentDescription="@string/sync_product"
                            android:src="@drawable/ic_box"
                            app:tint="@color/main" />
                    </FrameLayout>

                    <LinearLayout style="@style/MoreMenuTextContainer">

                        <TextView
                            style="@style/MoreMenuTitle"
                            android:text="@string/sync_product" />

                        <TextView
                            style="@style/MoreMenuSubtitle"
                            android:text="@string/sync_product_subtitle" />
                    </LinearLayout>

                    <ImageView
                        style="@style/MoreMenuArrow"
                        android:contentDescription="@null" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnDoctorSyncs"
                    style="@style/MoreMenuCard">

                    <FrameLayout style="@style/MoreMenuIconContainer">

                        <ImageView
                            style="@style/MoreMenuIcon"
                            android:contentDescription="@string/sync_doctor"
                            android:src="@drawable/ic_doctor"
                            app:tint="@color/main" />
                    </FrameLayout>

                    <LinearLayout style="@style/MoreMenuTextContainer">

                        <TextView
                            style="@style/MoreMenuTitle"
                            android:text="@string/sync_doctor" />

                        <TextView
                            style="@style/MoreMenuSubtitle"
                            android:text="@string/sync_doctor_subtitle" />
                    </LinearLayout>

                    <ImageView
                        style="@style/MoreMenuArrow"
                        android:contentDescription="@null" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnOtherSyncs"
                    style="@style/MoreMenuCard">

                    <FrameLayout style="@style/MoreMenuIconContainer">

                        <ImageView
                            style="@style/MoreMenuIcon"
                            android:contentDescription="@string/sync_market_structure"
                            android:src="@drawable/ic_market_research"
                            app:tint="@color/main" />
                    </FrameLayout>

                    <LinearLayout style="@style/MoreMenuTextContainer">

                        <TextView
                            style="@style/MoreMenuTitle"
                            android:text="@string/sync_market_structure" />

                        <TextView
                            style="@style/MoreMenuSubtitle"
                            android:text="@string/sync_market_subtitle" />
                    </LinearLayout>

                    <ImageView
                        style="@style/MoreMenuArrow"
                        android:contentDescription="@null" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="10dp"
                    android:fontFamily="@font/roboto"
                    android:text="@string/account_and_device"
                    android:textColor="@color/more_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/btn_settings"
                    style="@style/MoreMenuCard"
                    android:layout_marginTop="0dp">

                    <FrameLayout style="@style/MoreMenuIconContainer">

                        <ImageView
                            style="@style/MoreMenuIcon"
                            android:contentDescription="@string/settings"
                            android:src="@drawable/ic_settings"
                            app:tint="@color/main" />
                    </FrameLayout>

                    <LinearLayout style="@style/MoreMenuTextContainer">

                        <TextView
                            style="@style/MoreMenuTitle"
                            android:text="@string/settings" />

                        <TextView
                            style="@style/MoreMenuSubtitle"
                            android:text="@string/settings_subtitle" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp">

                        <ImageView
                            android:id="@+id/settingdown"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_more_icon_tile"
                            android:clickable="true"
                            android:contentDescription="@string/expand_settings"
                            android:focusable="true"
                            android:padding="11dp"
                            android:src="@drawable/ic_down"
                            app:tint="@color/main" />

                        <ImageView
                            android:id="@+id/settingup"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_more_icon_tile"
                            android:clickable="true"
                            android:contentDescription="@string/collapse_settings"
                            android:focusable="true"
                            android:padding="10dp"
                            android:src="@drawable/ic_arrow_up_24"
                            android:visibility="gone"
                            app:tint="@color/main" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/settingLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_more_details_panel"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/MoreInfoLabel"
                                android:text="@string/version" />

                            <TextView
                                android:id="@+id/tv_versionname"
                                style="@style/MoreInfoValue"
                                tools:text="1.9.7" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/MoreInfoLabel"
                                android:text="@string/network" />

                            <TextView
                                android:id="@+id/tv_network"
                                style="@style/MoreInfoValue"
                                tools:text="Wi-Fi" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/MoreInfoLabel"
                                android:text="@string/last_sync" />

                            <TextView
                                android:id="@+id/tv_lastsynctime"
                                style="@style/MoreInfoValue"
                                android:ellipsize="end"
                                android:maxLines="1"
                                tools:text="Today" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="12dp"
                        android:background="#D8E4F3" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btn_locationcheck"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_more_icon_primary"
                            android:contentDescription="@string/check_my_location"
                            android:padding="10dp"
                            android:src="@drawable/ic_location"
                            app:tint="@color/white" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/roboto"
                                android:text="@string/check_my_location"
                                android:textColor="@color/more_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/roboto"
                                android:text="@string/location_subtitle"
                                android:textColor="@color/more_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <fragment
                        android:id="@+id/map_more"
                        android:name="com.google.android.gms.maps.SupportMapFragment"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="12dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_changepw"
                    style="@style/MoreMenuCard">

                    <FrameLayout style="@style/MoreMenuIconContainer">

                        <ImageView
                            style="@style/MoreMenuIcon"
                            android:contentDescription="@string/change_password"
                            android:src="@drawable/ic_lock"
                            app:tint="@color/main" />
                    </FrameLayout>

                    <LinearLayout style="@style/MoreMenuTextContainer">

                        <TextView
                            style="@style/MoreMenuTitle"
                            android:text="@string/change_password" />

                        <TextView
                            style="@style/MoreMenuSubtitle"
                            android:text="@string/change_password_subtitle" />
                    </LinearLayout>

                    <ImageView
                        style="@style/MoreMenuArrow"
                        android:contentDescription="@null" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">

                    <View
                        android:id="@+id/tbnStoretoMemory"
                        android:layout_width="1dp"
                        android:layout_height="1dp" />

                    <View
                        android:id="@+id/tbnLoadfromLocal"
                        android:layout_width="1dp"
                        android:layout_height="1dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
