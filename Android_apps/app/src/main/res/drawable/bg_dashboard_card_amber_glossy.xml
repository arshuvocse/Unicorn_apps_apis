<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:centerColor="#FFF9EC"
                android:endColor="#F8E5B5"
                android:startColor="#FFFFFF" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#E5C66F" />
        </shape>
    </item>
    <item android:bottom="40dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="7dp" android:topRightRadius="7dp" />
            <gradient android:angle="270" android:endColor="#00FFFFFF" android:startColor="#BFFFFFFF" />
        </shape>
    </item>
</layer-list>
