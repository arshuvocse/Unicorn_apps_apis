<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="20dp" />
            <solid android:color="#35FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#A6FFFFFF" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="20dp" />
            <gradient
                android:angle="270"
                android:endColor="#20FFFFFF"
                android:startColor="#42FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#70FFFFFF" />
        </shape>
    </item>
</selector>
