<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#CFE3FA"
                android:startColor="#E5F1FF" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="#77A9E2" />
        </shape>
    </item>

    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="315"
                        android:centerColor="#F8FBFF"
                        android:endColor="#E8F2FF"
                        android:startColor="#FFFFFF" />
                    <corners android:radius="16dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#AFCBED" />
                </shape>
            </item>

            <item
                android:bottom="22dp"
                android:left="1dp"
                android:right="1dp"
                android:top="1dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:endColor="#00FFFFFF"
                        android:startColor="#A8FFFFFF" />
                    <corners
                        android:topLeftRadius="15dp"
                        android:topRightRadius="15dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
