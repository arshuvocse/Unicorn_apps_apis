<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="16dp" />
            <gradient
                android:angle="315"
                android:endColor="#EEF4FC"
                android:startColor="#FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#D8E4F2" />
        </shape>
    </item>
    <item
        android:bottom="38dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape>
            <corners
                android:topLeftRadius="15dp"
                android:topRightRadius="15dp" />
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#B8FFFFFF" />
        </shape>
    </item>
</layer-list>
