<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="ThemeOverlay_App_MaterialAlertDialog" parent="Theme.MaterialComponents.Dialog">
<!--        <item name="shapeAppearance">@style/ShapeAppearance.App.SmallComponent</item>-->
        <item name="android:textAppearance">@font/roboto</item>
        <item name="android:textColor">@color/colorAccent</item>
        <item name="android:textAllCaps">true</item>
        <item name="colorPrimary">@color/main</item>
       <!-- <item name="android:textColor">@color/black</item>-->
        <item name="android:textColorPrimary">#f3f3f3</item>
        <item name="android:fontFamily">@font/robotolight</item>

    </style>

    <style name="tab_text" parent="@android:style/TextAppearance.Widget.TabWidget">
        <item name="android:fontFamily">@font/robotolight</item>
    </style>

    <style name="MoreMenuCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">76dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/bg_more_menu_card</item>
        <item name="android:clickable">true</item>
        <item name="android:elevation">3dp</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
    </style>

    <style name="MoreMenuIconContainer">
        <item name="android:layout_width">46dp</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:background">@drawable/bg_more_icon_tile</item>
    </style>

    <style name="MoreMenuIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_gravity">center</item>
    </style>

    <style name="MoreMenuTextContainer">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="MoreMenuTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/roboto</item>
        <item name="android:textColor">@color/more_text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="MoreMenuSubtitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:fontFamily">@font/roboto</item>
        <item name="android:textColor">@color/more_text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="MoreMenuArrow">
        <item name="android:layout_width">18dp</item>
        <item name="android:layout_height">18dp</item>
        <item name="android:src">@drawable/ic_arrow_point_to_right</item>
        <item name="tint">@color/main</item>
    </style>

    <style name="MoreInfoLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/roboto</item>
        <item name="android:textColor">@color/more_text_secondary</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="MoreInfoValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:fontFamily">@font/roboto</item>
        <item name="android:textColor">@color/more_text_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <!--    <style name="Widget.App.Button" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
            <item name="shapeAppearance">@style/ShapeAppearance.App.SmallComponent</item>
            <item name="android:textAppearance">@style/Roboto.Bold.Small</item>
            <item name="android:textColor">@color/colorAccent</item>
            <item name="android:textAllCaps">true</item>
        </style>-->
</resources>
